# Порт, на котором запускается сервер
PORT=3000

# Публичный адрес приложения, БЕЗ слэша в конце
# (используется для редиректа после оплаты и для вебхука SPWorlds)
PUBLIC_URL=https://your-domain.example

# ID и токен карты SPWorlds, на которую поступают эскроу-платежи биржи
# Получить можно в приложении SPWorlds на телефоне: Карта -> API
SPW_CARD_ID=
SPW_CARD_TOKEN=

# Токен мини-приложения (генерируется на spworlds.ru в настройках приложения)
# Нужен для проверки подлинности пользователей через spwmini
SPWMINI_APP_TOKEN=
