# Скопируй этот файл в .env и заполни своими значениями.
# .env никогда не коммить и не публикуй — там секретные токены.

# Порт, на котором запустится сервер
PORT=3000

# Публичный адрес твоего сайта (без слэша на конце).
# Именно на PUBLIC_URL/api/webhook SPWorlds будет слать уведомления об оплате.
PUBLIC_URL=https://podryad.example.com

# Карта БИРЖИ — это эскроу-счёт, на который сначала падают деньги заказчика.
# Получить ID и токен: Кошелёк -> Поделиться картой (на spworlds.ru)
SPW_CARD_ID=
SPW_CARD_TOKEN=

# Токен мини-приложения. Получить после регистрации приложения
# на странице /<сервер>/apps/ на spworlds.ru (показывается один раз!)
SPWMINI_APP_TOKEN=
